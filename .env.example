# --- Copier en .env et remplir. Le .env n'est JAMAIS commité. ---

# Postgres
POSTGRES_DB=manahome
POSTGRES_USER=manahome
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://manahome:change-me@db:5432/manahome

# Auth (JWT)
AUTH_SECRET=change-me

# Object Storage S3 (OVHcloud / RustFS)
S3_ENDPOINT=
S3_BUCKET=manahome-medias
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=gra

# LLM (rédaction assistée uniquement)
MISTRAL_API_KEY=

# Feature flags
FEATURE_GEDEON=false

# Catalogue moissonné (lecture publique) — la clé anonyme de db.temposystem.fr.
# ⭐ Publique par construction : c'est celle que tout navigateur reçoit déjà sur
#    mana.bzh et manafrance.org, et elle n'ouvre que des fonctions de LECTURE.
# ⛔ Sans elle, le catalogue d'établissements importés reste vide et l'écran
#    garde ses annonces de démonstration — un oubli ne casse rien, il se voit.
VITE_CLE_CATALOGUE=
