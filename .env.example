# --- Copier en .env et remplir. Le .env n'est JAMAIS commité. ---

# Postgres
POSTGRES_DB=manahome
POSTGRES_USER=manahome
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://manahome:change-me@db:5432/manahome

# Auth (JWT)
AUTH_SECRET=change-me

# Object Storage S3 (OVHcloud / RustFS)
S3_ENDPOINT=
S3_BUCKET=manahome-medias
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=gra

# LLM (rédaction assistée uniquement)
MISTRAL_API_KEY=

# Feature flags
FEATURE_GEDEON=false
